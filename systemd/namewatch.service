# cp systemd/namewatch.service ~/.config/systemd/user/
# systemctl --user daemon-reload && systemctl --user enable --now namewatch
[Unit]
Description=namewatch: приглушать звук, когда зовут по имени
After=pipewire.service pipewire-pulse.service sound.target

[Service]
ExecStart=%h/.local/bin/namewatch run
Restart=on-failure
RestartSec=3
Nice=10

[Install]
WantedBy=default.target
